  booktitle = {2025 {{International Conference}} on {{Artificial Intelligence}}, {{Computer}}, {{Data Sciences}} and {{Applications}} ({{ACDSA}})},
  author = {Dildabek, Aizat and Sarsembayeva, Talshyn and Abdiakhmetova, Zukhra},
