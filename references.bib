@inproceedings{zhangImpactSyntheticData2026,
  title = {The {{Impact}} of {{Synthetic Data Generation}} on {{Machine Learning Performance}}: {{A Study}} on the {{Titanic Dataset}}},
  shorttitle = {The {{Impact}} of {{Synthetic Data Generation}} on {{Machine Learning Performance}}},
  booktitle = {2026 {{IEEE}} 2nd {{International Conference}} on {{Electronics}}, {{Energy Systems}} and {{Power Engineering}} ({{EESPE}})},
  author = {Zhang, Hao},
  date = {2026-06},
  pages = {1332--1336},
  doi = {10.1109/EESPE68405.2026.11649021},
  url = {https://ieeexplore.ieee.org/document/11649021/},
  urldate = {2026-09-17},
  abstract = {This study investigates whether simple synthetic data generation can improve machine learning performance on datasets. In many real-world scenarios, collecting large and high-quality datasets takes a long time and many people, so synthetic data is an alternative. However, it is unknown if basic synthetic generation techniques can consistently improve model performance. To address this question, this study uses the Titanic dataset from Kaggle and tests three machine learning models: Random Forest, K-Nearest Neighbors (KNN), and Decision Tree. The experimental settings are 1) training on the original dataset. 2) training with raw synthetic data and 3) training with preprocessed synthetic data. Synthetic samples of different sizes (200,300,400,500) were generated and added to the training data, and model performance was tested using precision, recall, and F1-score. The results show that adding synthetic data generally improves model performance, especially for Random Forest and KNN. The best performance was using raw synthetic data, even though excessive data or preprocessing may reduce effectiveness. Overall, this study shows that simple synthetic data generation can improve model performance.},
  eventtitle = {2026 {{IEEE}} 2nd {{International Conference}} on {{Electronics}}, {{Energy Systems}} and {{Power Engineering}} ({{EESPE}})},
  keywords = {data augmentation,Data collection,Decision trees,machine learning,Machine learning,Machining,model evaluation,Modeling,Printing,Random forests,Synthetic data,Testing,Training},
  file = {C:\Users\kegle\Zotero\storage\VRIZJ5D7\Zhang - 2026 - The Impact of Synthetic Data Generation on Machine Learning Performance A Study on the Titanic Data.pdf}
}
