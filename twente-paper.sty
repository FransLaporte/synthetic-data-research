\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\newcommand{\eyebrow}[1]{{\fontsize{8}{10}\selectfont\bfseries\MakeUppercase{#1}\par}}
\newsavebox{\researchsave}
\newenvironment{researchbox}[1]{\par\begingroup\setlength{\fboxsep}{5mm}\noindent\begin{lrbox}{\researchsave}\begin{minipage}{\dimexpr\linewidth-10mm\relax}\eyebrow{#1}\vspace{2mm}\small}{\end{minipage}\end{lrbox}\colorbox{papergray}{\usebox{\researchsave}}\endgroup\par}
