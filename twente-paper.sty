\hypersetup{colorlinks=true,allcolors=ink,bookmarksnumbered=true}
\color{ink}
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}
\renewcommand{\baselinestretch}{1.16}
\setcounter{tocdepth}{1}
\setlength{\emergencystretch}{2em}
\titleformat{\section}{\Large\bfseries}{\makebox[11mm][l]{\color{muted}\fontsize{11}{13}\selectfont\ifnum\value{section}<10 0\fi\thesection}}{0pt}{}
